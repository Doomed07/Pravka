FROM golang:1.27.1-bookworm AS builder
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY web ./web
RUN CGO_ENABLED=0 go build -tags timetzdata -o /app/exe ./cmd/pravkiapp

FROM alpine:3.24
WORKDIR /app
RUN adduser -D -H pravki
COPY --from=builder /app/exe /app/exe
USER pravki
CMD ["/app/exe"]
