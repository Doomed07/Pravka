# Скопируйте в .env и поменяйте значения (make env-init сделает это и подставит случайные пароли).

# Веб-сервис
HTTP_ADDR=:8080
HTTP_SHUTDOWN_TIMEOUT=30s
APP_PORT=127.0.0.1:8080        # на сервере за прокси с HTTPS оставьте 127.0.0.1; 0.0.0.0:8080 — открыть всем
LOGGER_LVL=info
TIME_ZONE=Europe/Moscow
METRICS_ADDR=:2112

# База
POSTGRES_USER=pravki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pravki
POSTGRES_TIMEOUT=10s

# Вход
AUTH_SESSION_TTL=720h
AUTH_BCRYPT_COST=12
AUTH_COOKIE_SECURE=false       # true, если сервис открыт по HTTPS
AUTH_SIGNUP_CODE=              # код приглашения; на удалённом сервере обязательно задайте

# Движок разбора (Python)
ENGINE_TOKEN=change-me
ENGINE_TIMEOUT=5m

# Модель для пояснений (Ollama в Docker). Пусто — пояснений нет, решения всё равно принимает плейбук.
# В Docker: http://ollama:11434/v1 ; Ollama, установленный прямо на Mac (быстрее, с ускорением Apple): http://host.docker.internal:11434/v1
PRAVKI_LLM_URL=
PRAVKI_LLM_MODEL=qwen2.5:7b-instruct

GRAFANA_ADMIN_PASSWORD=change-me
